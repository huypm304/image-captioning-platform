pipeline {
  agent none 

  parameters {
    string(
      name: 'AGENT_LABEL',
      defaultValue: 'laptop', 
      description: 'Jenkins agent label to run all terraform stages on'
    )
    choice(
      name: 'STAGE',
      choices: ['plan', 'apply', 'plan-then-apply', 'destroy'],
    )
  }

  environment {
    AWS_DEFAULT_REGION = 'ap-southeast-1'
    TF_IN_AUTOMATION   = 'true'
    TF_INPUT           = 'false'
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  triggers {
    pollSCM('H/5 * * * *')
  }

  stages {
    stage('Terraform Infrastructure Management') {
      steps {
        script {
          def order = []
          switch (params.STAGE) {
            case 'plan':
              order = ['tf-init', 'tf-plan']
              break
            case 'apply':
              order = ['tf-init', 'tf-apply']
              break
            case 'plan-then-apply':
              order = ['tf-init', 'tf-plan', 'tf-apply']
              break
            case 'destroy':
              order = ['tf-init', 'tf-destroy']
              break
            default:
              order = ['tf-init', 'tf-plan']
          }

          node(params.AGENT_LABEL) {
            checkout scm

            withCredentials([[
              $class: 'AmazonWebServicesCredentialsBinding',
              credentialsId: 'aws-creds-id' 
            ]]) {
              
              order.each { sName ->
                def cfg = readYaml file: "jenkins/stages/${sName}.yaml"
                
                stage(cfg.name) {
                  echo "--- Starting stage: ${cfg.name} ---"
                  
                  cfg.steps.each { cmd -> 
                    sh "cd terraform && ${cmd}" 
                  }

                  if (cfg.containsKey('archive') && cfg.archive) {
                    echo "Archiving artifact: ${cfg.archive}"
                    archiveArtifacts artifacts: "terraform/${cfg.archive}", allowEmptyArchive: true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}