pipeline {
  agent none

  parameters {
    string(
      name: 'AGENT_LABEL',
      defaultValue: 'Laptop',
      description: 'Jenkins agent label to run all terraform stages on (e.g. laptop)'
    )
    choice(
      name: 'STAGE',
      choices: ['plan', 'apply', 'plan-then-apply', 'destroy'],
      description: 'plan = init+plan (use with pollSCM). apply = init+apply. plan-then-apply = same workspace. destroy = teardown.'
    )
  }

  environment {
    AWS_DEFAULT_REGION = 'ap-southeast-1'
    TF_IN_AUTOMATION   = 'true'
    TF_INPUT           = 'false'
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  triggers {
    pollSCM('H/5 * * * *')
  }

  stages {
    stage('Run') {
      steps {
        script {
          def order = []
          switch (params.STAGE) {
            case 'plan':
              order = ['tf-init', 'tf-plan']
              break
            case 'apply':
              order = ['tf-init', 'tf-apply']
              break
            case 'plan-then-apply':
              order = ['tf-init', 'tf-plan', 'tf-apply']
              break
            case 'destroy':
              order = ['tf-init', 'tf-destroy']
              break
            default:
              order = ['tf-init', 'tf-plan']
          }

          withCredentials([[
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'aws-creds-id'
          ]]) {
            order.each { sName ->
              def cfg = readYaml file: "jenkins/stages/${sName}.yaml"
              stage(cfg.name) {
                node(params.AGENT_LABEL) {
                  checkout scm
                  cfg.steps.each { cmd -> sh cmd }
                  if (cfg.containsKey('archive') && cfg.archive) {
                    archiveArtifacts artifacts: cfg.archive, allowEmptyArchive: true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
