pipeline {
  agent { label 'laptop' }

  parameters {
    choice(
      name: 'STAGE',
      choices: ['all', 'checkout', 'build', 'test', 'deploy'],
      description: 'Stage to run. all = run all in order.'
    )
  }

  environment {
    AWS_REGION         = 'ap-southeast-1'
    AWS_DEFAULT_REGION = 'ap-southeast-1'
    CLUSTER_NAME       = 'cms-devops-dev-eks'
    ECR_REPO           = 'cms-devops-dev-app'
    // Jenkins credential type "Secret text": registry host only, e.g. 123456789012.dkr.ecr.ap-southeast-1.amazonaws.com
    ECR_REGISTRY       = credentials('ecr-registry-url')
  }

  stages {
    stage('Run pipeline') {
      steps {
        script {
          def order = ['checkout', 'build', 'test', 'deploy']
          def toRun = params.STAGE == 'all' ? order : [params.STAGE]

          withCredentials([[
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'id-creds-aws'
          ]]) {
            toRun.each { sName ->
              def cfg = readYaml file: "jenkins/stages/${sName}.yaml"
              stage(cfg.name) {
                node(cfg.agent) {
                  checkout scm
                  cfg.steps.each { cmd -> sh cmd }
                }
              }
            }
          }
        }
      }
    }
  }
}
