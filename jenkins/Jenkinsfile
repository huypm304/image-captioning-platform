pipeline {
  agent none

  parameters {
    string(
      name: 'AGENT_LABEL',
      defaultValue: 'laptop',
      description: 'Jenkins agent label to run all stages on (e.g. laptop)'
    )
    choice(
      name: 'STAGE',
      choices: ['all', 'checkout', 'build', 'test', 'deploy'],
      description: 'Stage to run. all = run all in order.'
    )
  }

  environment {
    AWS_REGION         = 'ap-southeast-1'
    AWS_DEFAULT_REGION = 'ap-southeast-1'
    CLUSTER_NAME       = 'image-caption-dev-eks'
    ECR_REPO_BE        = 'image-caption-dev-app'
    ECR_REPO_FE        = 'image-caption-dev-frontend'
  }

  stages {
    stage('Run pipeline') {
      steps {
        script {
          def order = ['checkout', 'build', 'test', 'deploy']
          def toRun = params.STAGE == 'all' ? order : [params.STAGE]

          withCredentials([[
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'aws-creds-id'
          ]]) {
            node(params.AGENT_LABEL) {
              checkout scm
              script {
                def accountId = sh(
                  returnStdout: true,
                  script: 'aws sts get-caller-identity --query Account --output text'
                ).trim()
                env.ECR_REGISTRY = "${accountId}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                echo "Using ECR_REGISTRY=${env.ECR_REGISTRY}"
              }

              toRun.each { sName ->
                def cfg = readYaml file: "jenkins/stages/${sName}.yaml"
                stage(cfg.name) {
                  cfg.steps.each { cmd -> sh cmd }
                }
              }
            }            
          }
        }
      }
    }
  }
}
